    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Shield / Hexagonal Prism Base -->
    <path
        android:pathData="M54,26 L78,40 L78,68 L54,82 L30,68 L30,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#6366F1" />
                <item android:offset="0.5" android:color="#8B5CF6" />
                <item android:offset="1.0" android:color="#EC4899" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Inner Facet Accent -->
    <path
        android:pathData="M54,30 L74,42 L74,66 L54,78 L34,66 L34,42 Z"
        android:fillColor="#18181B" />
        
    <!-- Play Core Triangle -->
    <path
        android:pathData="M48,44 L66,54 L48,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="44"
                android:endX="66"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.5" android:color="#818CF8" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Top Sparkle / Diamond Star -->
    <path
        android:pathData="M54,34 L56,38 L60,40 L56,42 L54,46 L52,42 L48,40 L52,38 Z"
        android:fillColor="#FDF4FF" />
</vector>
